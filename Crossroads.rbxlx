				<int name="BrickColor">1004</int>
				<CoordinateFrame name="CFrame"><X>-150</X><Y>1.5</Y><Z>172</Z><R00>0</R00><R01>-1</R01><R02>0</R02><R10>1</R10><R11>0</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame>
